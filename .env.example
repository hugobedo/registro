# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DELETE_RECORDS_PASSWORD: Server-side authorization password required before deleting all shift records.
# Configure this value in Settings -> Secrets (do not commit the real password to source control).
DELETE_RECORDS_PASSWORD=
